/* Calm, low-contrast chrome with one soft accent; status colours appear only on data. */
Screen { background: #15171c; color: #c9ced8; }
Header { background: #1b1e25; color: #c9ced8; }
Footer { background: #1b1e25; }
TabbedContent { height: 1fr; }
TabPane { padding: 0; }
RunsPane, SourcesPane, LivePane { height: 1fr; width: 1fr; }
#runs-body { height: 1fr; }
#sources-body { height: 1fr; }
Tabs { background: #15171c; }
Tab { color: #7d8594; }
Tab.-active { color: #e6e9ef; text-style: bold; }
Underline > .underline--bar { color: #7aa2c4; background: #2e333d; }

OptionList, DataTable, VerticalScroll#runs-detail, VerticalScroll#source-detail-box {
    background: #181b21;
    border: round #2e333d;
    border-title-color: #8c95a6;
    scrollbar-size-vertical: 1;
}
OptionList:focus, DataTable:focus, VerticalScroll#runs-detail:focus-within,
VerticalScroll#source-detail-box:focus {
    border: round #7aa2c4;
    border-title-color: #c9ced8;
}
OptionList > .option-list--option-highlighted, DataTable > .datatable--cursor {
    background: #26303c;
    color: #e6e9ef;
}
DataTable > .datatable--header { background: #181b21; color: #7d8594; text-style: none; }

.placeholder { margin: 2 4; color: #7d8594; }
#runs-empty { margin: 2 4; color: #7d8594; }
#runs-left { width: 36%; min-width: 34; }
#run-list { height: 9; }
#topic-table { height: 1fr; }
#runs-detail { width: 1fr; padding: 0 1; }
#signals { height: auto; max-height: 8; margin-top: 1; }
#exchanges { height: auto; max-height: 6; margin-top: 1; }
#detail { height: auto; }

#filter { margin: 0 0 0 0; border: round #7aa2c4; background: #181b21; }
#sources-table { height: 1fr; }
#source-detail-box { height: 10; padding: 0 1; }
#test-progress { padding: 0 1; height: 1; }

InspectorScreen, HelpScreen, RunCountScreen { align: center middle; background: #0c0d10; }
#inspector { width: 92%; height: 92%; background: #181b21; border: round #7aa2c4; }
#inspector VerticalScroll { padding: 0 1; }
#inspector-keys { height: 1; padding: 0 1; color: #7d8594; background: #1b1e25; }
#help { width: 72; height: auto; background: #181b21; border: round #7aa2c4; padding: 1 2; }
#help-keys { margin-top: 1; }

/* Live tab */
LivePane { layout: vertical; padding: 0 1; }
#pipeline { height: 4; }
LivePane.compact #pipeline { height: 2; }
#live-mid { height: 8; }
LivePane.compact #live-mid { height: 6; }
#sources-box, #gauges, #events, #live-result {
    background: #181b21; border: round #2e333d; border-title-color: #8c95a6;
    scrollbar-size-vertical: 1;
}
#sources-box { width: 1fr; padding: 0 1; }
#gauges { width: 34; padding: 0 1; }
#g-cost, #g-rest { height: auto; }
#cost-bar { height: 1; width: 1fr; }
#cost-bar Bar { width: 1fr; }
#cost-bar Bar > .bar--bar { color: #7aa2c4; background: #2e333d; }
#cost-bar Bar > .bar--complete { color: #8fbf9f; }
#cost-bar.hot Bar > .bar--bar { color: #d9b26f; }
#live-result { height: auto; max-height: 5; padding: 0 1; }
#events { height: 1fr; padding: 0 1; }
#events:focus { border: round #7aa2c4; }
#live-controls { height: 1; }
#live-controls Button { height: 1; width: 16; border: none; margin-right: 2; padding: 0 1; }
#live-controls Button:disabled { opacity: 60%; }
#run-counter { width: auto; padding: 0 1; color: #d9b26f; text-style: bold; }
#run-count { width: 60; height: auto; background: #181b21; border: round #7aa2c4; padding: 1 2; }
